<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:FinalCheck.Core.Management"
             xmlns:vm="using:FinalCheck.App.ViewModels" x:Class="FinalCheck.App.Views.ComparisonSetupView"
             x:DataType="vm:ComparisonSetupViewModel">
  <StackPanel Spacing="20">
    <Grid ColumnDefinitions="*,20,*">
      <Border x:Name="BaselineZone" Background="#F0F4F8" Padding="20" CornerRadius="8">
        <StackPanel Spacing="12">
          <TextBlock Text="比对基准" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding BaselineInfo}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding MatchMessage}" TextWrapping="Wrap" FontSize="12" />
          <ProgressBar IsVisible="{Binding IsMatching}" IsIndeterminate="True" />
          <WrapPanel><Button Content="更换基准 / 查看模板候选" Command="{Binding ChangeBaselineCommand}" /><Button Content="重新匹配模板" Command="{Binding RematchTemplatesCommand}" Margin="8,0,0,0" /></WrapPanel>
          <ComboBox ItemsSource="{Binding TemplateCandidates}" SelectedItem="{Binding SelectedTemplate}" IsVisible="{Binding ShowTemplateChoices}" PlaceholderText="选择模板当前/历史版本">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="m:TemplateRecommendationCandidate"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <WrapPanel>
            <Button Content="选择 / 替换基准 DOCX" Click="PickBaseline" AutomationProperties.Name="选择基准版本" ToolTip.Tip="选择一个 DOCX 文件" />
            <Button Content="移除" Command="{Binding RemoveBaselineCommand}" Margin="8,0,0,0" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border x:Name="CurrentZone" Grid.Column="2" Background="#F0F4F8" Padding="20" CornerRadius="8">
        <StackPanel Spacing="12">
          <TextBlock Text="当前版本" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="{Binding CurrentInfo}" TextWrapping="Wrap" />
          <WrapPanel>
            <Button Content="选择 / 替换当前 DOCX" Click="PickCurrent" AutomationProperties.Name="选择当前版本" ToolTip.Tip="选择一个 DOCX 文件" />
            <Button Content="移除" Command="{Binding RemoveCurrentCommand}" Margin="8,0,0,0" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <ProgressBar IsVisible="{Binding IsExecuting}" IsIndeterminate="True" />
    <WrapPanel>
      <Button Content="开始比对" Command="{Binding StartCommand}" IsDefault="True" AutomationProperties.Name="开始比对" />
      <Button Content="取消" Command="{Binding CancelCommand}" IsVisible="{Binding IsExecuting}" Margin="8,0" IsCancel="True" />
    </WrapPanel>
    <StackPanel IsVisible="{Binding IdenticalPrompt}" Spacing="8">
      <Button Content="仍然执行比对" Command="{Binding ContinueIdenticalCommand}" />
      <Button Content="取消相同比对" Command="{Binding CancelCommand}" />
    </StackPanel>
    <StackPanel IsVisible="{Binding ShowPartial}" Spacing="8">
      <TextBlock Text="本次比对结果可能不完整。" Foreground="#9A5B00" />
      <ItemsControl ItemsSource="{Binding Session.Diagnostics}" />
      <Button Content="继续查看结果" Command="{Binding ViewPartialCommand}" />
    </StackPanel>
    <Expander Header="查看技术详情"><TextBlock Text="{Binding TechnicalDetails}" TextWrapping="Wrap" /></Expander>
  </StackPanel>
</UserControl>
