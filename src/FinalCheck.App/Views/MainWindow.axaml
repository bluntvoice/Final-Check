<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FinalCheck.App.ViewModels"
        xmlns:views="using:FinalCheck.App.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1080"
        d:DesignHeight="680"
        x:Class="FinalCheck.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1080"
        Height="680"
        MinWidth="840"
        MinHeight="520"
        Icon="/Assets/avalonia-logo.ico"
        Title="Final Check">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Grid ColumnDefinitions="160,*" Background="#F5F6F8">
    <Border Grid.Column="0" Background="#17202A" Padding="14">
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="4">
          <TextBlock Text="FINAL CHECK" FontSize="17" FontWeight="SemiBold" Foreground="White" />
          <TextBlock Text="合同版本与比对工具" FontSize="12" Foreground="#B8C2CC" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,36,0,0" Spacing="10">
          <StackPanel.Styles><Style Selector="Button"><Setter Property="Foreground" Value="White" /><Setter Property="Background" Value="#293A4C" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style></StackPanel.Styles>
          <Button Content="首页" Command="{Binding NavigateCommand}" CommandParameter="home" ToolTip.Tip="新建比对或继续最近记录" />
          <Button Content="模板中心" Command="{Binding NavigateCommand}" CommandParameter="templates" />
          <Button Content="快速比对" Command="{Binding NavigateCommand}" CommandParameter="compare" />
          <Button Content="合同项目" Command="{Binding NavigateCommand}" CommandParameter="projects" />
          <Button Content="归档" Command="{Binding NavigateCommand}" CommandParameter="archive" />
          <Button Content="回收站" Command="{Binding NavigateCommand}" CommandParameter="recycle" />
          <Button Content="比对结果" Command="{Binding NavigateCommand}" CommandParameter="results" IsVisible="{Binding HasResults}" />
          <Button Content="关于" Command="{Binding NavigateCommand}" CommandParameter="about" />
        </StackPanel>

        <TextBlock Grid.Row="2" Text="{Binding AppVersionLabel}" FontSize="11" Foreground="#8996A3" />
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="16" RowDefinitions="Auto,12,*">
      <StackPanel>
        <TextBlock Text="{Binding CurrentPageTitle}" FontSize="30" FontWeight="SemiBold" Foreground="#17202A" />
        <TextBlock Text="{Binding CurrentPageDescription}" Margin="0,8,0,0" FontSize="14" Foreground="#5C6773" />
      </StackPanel>

      <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16">
        <Grid>
          <StackPanel IsVisible="{Binding IsHome}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <TextBlock Text="两份合同，一次清晰比对" FontSize="24" />
            <Button Content="新建比对" Command="{Binding NavigateCommand}" CommandParameter="compare" HorizontalAlignment="Center" />
            <Button Content="继续最近一次比对" Command="{Binding LoadRecentCommand}" HorizontalAlignment="Center" />
          </StackPanel>
          <ScrollViewer IsVisible="{Binding IsSetup}"><views:ComparisonSetupView DataContext="{Binding Comparison}" /></ScrollViewer>
          <Grid IsVisible="{Binding IsResults}"><views:ComparisonResultsView DataContext="{Binding Results}" /></Grid>
          <Grid IsVisible="{Binding IsTemplates}"><views:TemplateCenterView DataContext="{Binding Templates}" /></Grid>
          <Grid IsVisible="{Binding IsProjects}"><views:ProjectsView DataContext="{Binding Projects}" /></Grid>
          <TextBlock IsVisible="{Binding IsOther}" Text="{Binding CurrentPageDescription}" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
    <Border Grid.ColumnSpan="2" IsVisible="{Binding LeavePrompt}" Background="#EEFFFFFF" Padding="32">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
        <TextBlock Text="比对仍在执行。离开将取消本次操作，是否继续？" TextWrapping="Wrap" />
        <Button Content="取消比对并离开" Command="{Binding ConfirmLeaveCommand}" />
        <Button Content="继续等待" Command="{Binding StayCommand}" IsCancel="True" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
